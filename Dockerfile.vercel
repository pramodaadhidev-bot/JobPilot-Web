FROM eclipse-temurin:8-jdk

WORKDIR /app

COPY . .

RUN javac -cp ".:lib/*" \
    WebServer.java \
    AdzunaClient.java \
    JobService.java \
    DatabaseApi.java \
    DatabaseService.java \
    FirebaseTokenVerifier.java \
    HttpRequest.java \
    SetupDatabase.java

CMD ["/opt/java/openjdk/bin/java", "-cp", ".:lib/*", "WebServer"]
